{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahjong-calculator",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // 정식 주소는 커스텀 도메인 하나로 통일한다.
  // workers.dev 주소를 열어두면 같은 사이트가 두 URL로 색인되므로 비활성.
  "workers_dev": false,
  "preview_urls": false,

  // 대시보드에서 연결한 커스텀 도메인. 여기 적어두지 않으면 배포 때마다 원격 설정을 덮어써
  // 도메인 연결이 끊길 수 있다. (www 는 DNS 레코드 + Redirect Rule 로 처리)
  "routes": [
    { "pattern": "panbu.cloud", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: 자산에 없는 경로(/calculator 등)는 index.html을 200으로 반환
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
